# Copy this file to .env and fill in your key(s), OR just paste them into
# the dashboard's config card -- it writes here automatically.

# Primary -- required for odds data.
ODDS_API_KEY=your_the_odds_api_key_here

# Backup 1 -- optional. https://parlay-api.com/
PARLAY_API_KEY=your_parlay_api_key_here

# Backup 2 -- optional. https://sharpapi.io/
SHARPAPI_KEY=your_sharpapi_key_here
